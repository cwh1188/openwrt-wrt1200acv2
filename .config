CONFIG_TARGET_mvebu=y
CONFIG_TARGET_mvebu_cortexa9=y
CONFIG_TARGET_mvebu_cortexa9_DEVICE_linksys_wrt1200ac-v2=y

# LuCI完整基础套件（保证网页界面齐全，不会缺JS文件）
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-static=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-zh-cn=y

# Passwall2 全套，内置xray，支持VLESS
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_trojan-plus=y

# 系统基础必备组件
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
